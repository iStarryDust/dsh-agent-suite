{
  "name": "@istarry/dsh-edit-regen",
  "description": "Standalone session-side verbs for the edit-and-regenerate surface: authorized file-attachment reads, the rewrite fork-boundary lookup, and durable session-shell cleanup",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "LICENSE",
    "README*.md"
  ],
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iStarryDust/dsh-agent-suite.git",
    "directory": "packages/edit-regen"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
