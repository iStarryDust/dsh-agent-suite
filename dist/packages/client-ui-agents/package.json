{
  "name": "@istarry/dsh-client-ui-agents",
  "description": "Agent identity browser: roster, profile forms, per-agent memory, and chat history",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iStarryDust/dsh-agent-suite.git",
    "directory": "packages/client-ui-agents"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@istarry/dsh-agent-preset-authoring",
        "@istarry/dsh-agent-memory",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@istarry/dsh-agent-memory": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@istarry/dsh-agent-preset-authoring": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-test-runtime": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "README*.md"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
