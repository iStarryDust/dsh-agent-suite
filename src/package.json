{
  "name": "@istarry/dsh-agent-suite",
  "description": "The agent suite: identity authoring, per-agent long-term memory, the hero mode chip, and edit-and-regenerate for user messages (images and files carried over, model and preset inherited)",
  "version": "0.1.4",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "README*.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --compare",
    "staging": "node build.mjs --staging",
    "rollback": "node build.mjs --rollback"
  },
  "dependencies": {
    "@istarry/dsh-agent-memory": "file:./packages/agent-memory",
    "@istarry/dsh-agent-preset-authoring": "file:./packages/agent-preset-authoring",
    "@istarry/dsh-client-ui-agents": "file:./packages/client-ui-agents",
    "@istarry/dsh-client-ui-edit-regen": "file:./packages/client-ui-edit-regen",
    "@istarry/dsh-client-ui-settings-agent-memory": "file:./packages/client-ui-settings-agent-memory"
  },
  "devDependencies": {
    "lightningcss": "1.32.0",
    "tsdown": "0.22.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iStarryDust/dsh-agent-suite.git"
  }
}
